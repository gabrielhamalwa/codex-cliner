# codex-cliner is a Bun/Node package.
# Keep source, docs, lockfiles, and workflow files tracked.
# Ignore generated artifacts, machine-local settings, caches, and local research material
# that are not part of the published package.

node_modules/
dist/
coverage/
.nyc_output/

# Logs and temp files
*.log
*.out
*.err
*.pid
*.pid.lock
*.seed
*.stackdump
*.tmp
tmp/
temp/

# Archives
*.tgz

# Environment and local overrides
.DS_Store
.env
.env.*
!.env.example
*.local

# Editor and IDE files
.vscode/
.idea/

# Caches
.cache/
.eslintcache
.npm/
.pnpm-store/

# TypeScript and test artifacts
*.tsbuildinfo
test-results/
playwright-report/
reports/
.vitest-cli-dist/

# Common framework/build caches
.next/
.turbo/
.vercel/

# Local-only material
.local/
