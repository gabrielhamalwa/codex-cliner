{
    "name": "codex-cliner",
    "version": "0.1.0",
    "description": "Backup-first local Codex cleanup and recovery manager.",
    "license": "MIT",
    "type": "module",
    "packageManager": "bun@1.3.11",
    "bin": {
        "codex-cliner": "./dist/cli.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "bun": ">=1.3.11",
        "node": ">=20"
    },
    "scripts": {
        "dev": "bun --watch src/cli.ts",
        "build": "bunx tsup src/cli.ts --format esm --dts --clean",
        "typecheck": "bunx tsc --noEmit",
        "test": "bunx vitest run",
        "test:watch": "bunx vitest",
        "lint": "bunx eslint .",
        "format": "bunx prettier --write .",
        "format:check": "bunx prettier --check .",
        "release:check": "node scripts/release-check.mjs",
        "security:check": "node scripts/security-check.mjs",
        "package:check": "bun run build && npm pack --dry-run"
    },
    "keywords": [
        "codex",
        "cli",
        "cleanup",
        "backup",
        "restore",
        "ink"
    ],
    "dependencies": {
        "ink": "^7.0.0",
        "react": "^19.2.0",
        "chalk": "^5.4.1",
        "commander": "^14.0.1",
        "fast-glob": "^3.3.3",
        "ink-text-input": "^6.0.0",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@types/node": "^24.7.2",
        "@types/react": "^19.2.2",
        "@typescript-eslint/eslint-plugin": "^8.46.1",
        "@typescript-eslint/parser": "^8.46.1",
        "eslint": "^9.37.0",
        "eslint-plugin-react": "^7.37.5",
        "prettier": "^3.6.2",
        "tsup": "^8.5.0",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4"
    }
}
